# Скопируйте файл в .env и заполните значения. .env в git не попадает.

# --- Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=
# Ваш chat_id для уведомлений об ошибках (узнать: команда /myid в этом боте)
ADMIN_CHAT_ID=

# --- Хранилище ---
# sheets — Google Sheets (локальная копия и очередь в SQLite), sqlite — только SQLite
STORAGE_BACKEND=sheets
# Путь к JSON-ключу сервисного аккаунта Google (или сам JSON одной строкой)
GOOGLE_CREDENTIALS_JSON=credentials/service_account.json
# ID таблицы или ссылка целиком: https://docs.google.com/spreadsheets/d/<ID>/edit
SPREADSHEET_ID=
# Файл локальной базы
SQLITE_PATH=data/tasks.db
# Как часто (мин) досылать в Sheets задачи из локальной очереди
SYNC_INTERVAL_MINUTES=5

# --- Погода (Open-Meteo, ключ не нужен) ---
# Координаты объекта (пример — Уфа)
WEATHER_LAT=54.7388
WEATHER_LON=55.9721
# Предупреждать, если минимальная температура ниже (°C)
TEMP_THRESHOLD=-10
# Предупреждать, если максимальный ветер выше (м/с)
WIND_THRESHOLD=10

# --- Сводка ---
# Время утренней сводки по часам сервера (ЧЧ:ММ)
DIGEST_TIME=09:00

# --- Логи ---
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
